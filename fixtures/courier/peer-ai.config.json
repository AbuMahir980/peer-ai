{
  "$schema": "https://raw.githubusercontent.com/AbuMahir980/peer-ai/main/packages/workflow/schemas/config.schema.json",
  "version": 1,
  "project": {
    "name": "Courier",
    "description": "Book a parcel pickup, pay for it, and track it to the door.",
    "stage": "mvp",
    "traits": ["money", "ai-features"],
    "origin": "existing",
    "team": "team"
  },
  "tools": ["claude-code", "codex", "cursor"],
  "tracks": [
    { "id": "web", "kind": "web", "path": "apps/web", "status": "active" },
    { "id": "api", "kind": "backend", "path": "services/api", "status": "active" }
  ],
  "apis": [
    {
      "id": "courier-api",
      "kind": "http",
      "providedBy": "api",
      "contract": { "source": "openapi", "location": "services/api/openapi.json" }
    }
  ],
  "tracker": { "kind": "none", "ticketPrefix": "CR" },
  "commands": { "verify": "python3 -m pytest services/api -q" },
  "compliance": { "jurisdictions": ["GB"], "industries": ["logistics", "payments"] }
}
