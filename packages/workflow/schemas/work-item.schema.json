{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Also the file name. Tracker keys work as they are, such as PROJ-14; a GitHub issue #42 becomes GH-42."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "feature",
        "bug",
        "refactor",
        "migration",
        "gap",
        "discovery",
        "chore"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "prepare",
        "build",
        "verify",
        "ship",
        "done",
        "cancelled"
      ]
    },
    "track": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "gap": {
      "description": "For kind gap: the map item this work fills.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "requirements",
            "architecture",
            "threat-model",
            "specs",
            "api-contract",
            "data-model",
            "design",
            "standards",
            "ci",
            "environments",
            "tests",
            "load-testing",
            "infrastructure",
            "observability",
            "slos",
            "runbooks",
            "docs"
          ]
        },
        {
          "type": "string",
          "pattern": "^x-[a-z0-9]+(-[a-z0-9]+)*$"
        }
      ]
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "understand",
              "architect",
              "specify",
              "contract",
              "standards",
              "delivery-setup",
              "plan",
              "build",
              "verify",
              "test",
              "ship",
              "operate",
              "document",
              "retro"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in-progress",
              "done",
              "skipped"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "position": {
      "description": "Where work stopped, so the next session resumes exactly there.",
      "type": "object",
      "properties": {
        "activity": {
          "type": "string",
          "enum": [
            "understand",
            "architect",
            "specify",
            "contract",
            "standards",
            "delivery-setup",
            "plan",
            "build",
            "verify",
            "test",
            "ship",
            "operate",
            "document",
            "retro"
          ]
        },
        "step": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "activity",
        "step"
      ],
      "additionalProperties": false
    },
    "lastVerify": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "result",
        "at"
      ],
      "additionalProperties": false
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "enum": [
              "requirements-analysis",
              "product-spec",
              "architecture",
              "system-design",
              "api-design",
              "data-modelling",
              "threat-model",
              "design-system",
              "issue-planning",
              "implement-ticket",
              "code-review",
              "security-review",
              "contract-check",
              "accessibility-review",
              "design-review",
              "performance-review",
              "reliability-review",
              "data-migration-review",
              "dependency-review",
              "test-strategy",
              "qa-acceptance",
              "ai-feature-review",
              "release-readiness",
              "infrastructure-review",
              "observability-review",
              "incident-response",
              "documentation",
              "tech-debt-triage"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "incomplete"
            ]
          },
          "report": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "skill",
          "result",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "reopened": {
      "description": "Earlier activities reopened for this item, such as a re-spec after a new decision.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activity": {
            "type": "string",
            "enum": [
              "understand",
              "architect",
              "specify",
              "contract",
              "standards",
              "delivery-setup",
              "plan",
              "build",
              "verify",
              "test",
              "ship",
              "operate",
              "document",
              "retro"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "activity",
          "reason",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "next": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "One line: the next action. The story belongs in CONTEXT.md."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "kind",
    "stage",
    "next",
    "updatedAt"
  ],
  "additionalProperties": false,
  "title": "Peer AI work item",
  "description": ".peer-ai/work/<id>.json: one piece of work, where it stands, and what comes next."
}
