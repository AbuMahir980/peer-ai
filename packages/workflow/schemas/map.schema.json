{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "assessedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "items": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "requirements",
              "architecture",
              "threat-model",
              "specs",
              "api-contract",
              "data-model",
              "data-inventory",
              "dpia",
              "design",
              "standards",
              "ci",
              "environments",
              "tests",
              "load-testing",
              "infrastructure",
              "observability",
              "slos",
              "runbooks",
              "docs"
            ]
          },
          {
            "type": "string",
            "pattern": "^x-[a-z0-9]+(-[a-z0-9]+)*$"
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "present",
              "partial",
              "missing",
              "not-applicable"
            ]
          },
          "evidence": {
            "description": "Files or URLs that prove the status.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inferred": {
            "description": "Found by reading the code, not a document, and not yet confirmed by a person.",
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "status",
          "checkedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "assessedAt",
    "items"
  ],
  "additionalProperties": false,
  "title": "Peer AI project map",
  "description": ".peer-ai/map.json: what the project has, what is partial, and what is missing, with evidence."
}
