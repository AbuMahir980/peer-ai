{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "enum": [
              "requirements-analysis",
              "product-spec",
              "architecture",
              "system-design",
              "api-design",
              "data-modelling",
              "threat-model",
              "design-system",
              "issue-planning",
              "implement-ticket",
              "code-review",
              "security-review",
              "contract-check",
              "accessibility-review",
              "design-review",
              "performance-review",
              "reliability-review",
              "data-migration-review",
              "dependency-review",
              "compliance-review",
              "test-strategy",
              "qa-acceptance",
              "ai-feature-review",
              "release-readiness",
              "infrastructure-review",
              "observability-review",
              "incident-response",
              "documentation",
              "tech-debt-triage"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "incomplete"
            ]
          },
          "open": {
            "type": "object",
            "properties": {
              "critical": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "high": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "medium": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "low": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "report": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,64}$",
            "description": "A git commit's id."
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "severity",
                "title"
              ],
              "additionalProperties": false
            },
            "description": "Its open findings at the blocking level or high, for work items to fix."
          }
        },
        "required": [
          "skill",
          "result",
          "report",
          "at",
          "findings"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "reviews"
  ],
  "additionalProperties": false,
  "title": "Peer AI whole-project reviews",
  "description": ".peer-ai/project-reviews.json: the latest review of the whole project from each skill, with its open findings."
}
