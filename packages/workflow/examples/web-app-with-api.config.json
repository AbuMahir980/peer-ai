{
  "$schema": "../schemas/config.schema.json",
  "version": 1,
  "project": {
    "name": "Tallyho",
    "description": "A shared to-do list for small teams",
    "stage": "mvp",
    "origin": "new",
    "team": "team"
  },
  "tools": ["claude-code", "cursor"],
  "design": { "status": "to-be-produced" },
  "tracks": [
    {
      "id": "web",
      "kind": "web",
      "path": "apps/web",
      "stack": ["typescript", "react"],
      "architecture": "feature-first",
      "consumes": ["tallyho-api"],
      "deploy": { "target": "vercel", "environments": ["staging", "production"] },
      "status": "active"
    },
    {
      "id": "api",
      "kind": "backend",
      "path": "apps/api",
      "stack": ["typescript", "node", "express"],
      "architecture": "layered",
      "deploy": { "target": "fly", "environments": ["staging", "production"] },
      "status": "active"
    }
  ],
  "apis": [
    {
      "id": "tallyho-api",
      "kind": "http",
      "providedBy": "api",
      "contract": { "source": "handwritten", "location": "docs/api-contract.md" }
    }
  ],
  "environments": [{ "id": "staging" }, { "id": "production", "production": true }],
  "repo": {
    "host": "github",
    "remote": "origin",
    "defaultBranch": "main",
    "branchNaming": "feature/{ticket}-{slug}",
    "commits": "conventional",
    "mergePolicy": "pull-request"
  },
  "tracker": { "kind": "github", "ticketPrefix": "TAL", "project": "tallyho-team/tallyho" },
  "commands": { "verify": "pnpm verify" },
  "delivery": { "ci": "none" },
  "standards": { "profiles": ["typescript", "react", "node", "express"] },
  "compliance": { "jurisdictions": ["GB"], "packs": ["uk-gdpr"] },
  "models": { "policy": "tiers" }
}
