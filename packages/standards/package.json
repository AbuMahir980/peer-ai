{
  "name": "peer-ai-standards",
  "version": "1.0.0-next.6",
  "description": "Peer AI's engineering standards: 197 rules for every project, and stack profiles with the tools that enforce them",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate-docs.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "peer-ai-workflow": "workspace:*",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbuMahir980/peer-ai.git",
    "directory": "packages/standards"
  },
  "homepage": "https://github.com/AbuMahir980/peer-ai#readme",
